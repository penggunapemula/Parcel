# Salin file ini menjadi ".env" lalu isi nilainya. Jangan unggah .env ke internet.

# ---------- Database ----------
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=parcelku
# Alternatif satu baris (database online): MYSQL_URL=mysql://user:sandi@host:4000/parcelku
# Database online (TiDB Cloud, Aiven, dll.) biasanya wajib SSL: isi MYSQL_SSL=1
MYSQL_SSL=0

# ---------- Foto unggahan ----------
# disk = simpan di folder uploads/ (komputer sendiri / VPS). db = simpan di database (WAJIB di Vercel).
# Di Vercel otomatis memakai "db", tidak perlu diisi.
STORAGE=disk

# ---------- Keamanan ----------
# Kata sandi masuk admin (WAJIB diganti)
ADMIN_PASSWORD=ganti-dengan-sandi-kuat

# Kunci sesi. Kosongkan bila ingin dibuat otomatis (disimpan di .secret_key)
SECRET_KEY=

# Isi 1 bila situs sudah memakai HTTPS (cookie login hanya dikirim lewat HTTPS)
PRODUCTION=0

# ---------- Notifikasi pesanan baru ke Telegram (opsional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
