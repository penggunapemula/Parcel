
{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server,database}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/beranda.html",
      "destination": "/masuk.html",
      "destination": "/pesan.html",
      "destination": "/admin.html",
      "destination": "/akun.html",
      "destination": "/pesanan.html",
      "destination": "/struk.html",
      "destination": "/lacak.html",
      "destination": "/404.html",
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index?__path=/uploads/:path*"
    }
  ]
}
