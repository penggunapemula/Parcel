{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index?__path=/uploads/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/beranda.html",
      "permanent": false
    }
  ]
}
